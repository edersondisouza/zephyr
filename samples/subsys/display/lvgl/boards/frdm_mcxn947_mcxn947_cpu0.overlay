#include <zephyr/dt-bindings/display/panel.h>
#include <freq.h>

/ {

    /* VCC J3.4 */
    /* GND J3.14 */

    chosen {
        zephyr,display = &gc9a01;
        zephyr,touch = &cst816s;
    };

    mipi_dbi {
        compatible = "zephyr,mipi-dbi-spi";
        status = "okay";
        spi-dev = <&flexcomm1_lpspi1>;
        dc-gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>; /* J4.6 */
        reset-gpios = <&gpio0 22 GPIO_ACTIVE_LOW>; /* J4.8 */
        #address-cells = <1>;
        #size-cells = <0>;
        write-only;

        gc9a01: gc9a01@0 {
            /* SCK J2.12 */
            /* MOSI J2.10 */
            /* MISO not used (J2.8) GND (J2.14) */
            /* CS J2.6 */
            compatible = "galaxycore,gc9x01x";
            reg = <0>;
/*            mipi-max-frequency = <DT_FREQ_M(100)>;*/
/*            mipi-max-frequency = <15151515>;*/
            mipi-max-frequency = <DT_FREQ_M(2) >;
            pixel-format = <PANEL_PIXEL_FORMAT_RGB_565>;
            width = <240>;
            height = <240>;
            display-inversion;
//            mipi-cpol;
//            mipi-cpha;
//              mipi-hold-cs;
        };
    };

    lvgl_pointer {
        compatible = "zephyr,lvgl-pointer-input";
        status = "okay";
        input = <&cst816s>;
    };

    lcd_backlight {
        compatible = "gpio-leds";
        status = "okay";

        led: led {
            gpios = <&gpio0 31 GPIO_ACTIVE_HIGH>; /* J1.16 */
        };
    };
};

&flexcomm1_lpspi1 {
    status = "okay";
};

&flexcomm2_lpi2c2 {
    status = "okay";
    /* SDA J2.18 */
    /* SCL J2.20 */
    cst816s: cst816s@15 {
        compatible = "hynitron,cst816s";
        status = "okay";
        reg = <0x15>;
        irq-gpios = <&gpio0 15 GPIO_ACTIVE_LOW>; /* J4.10 */
        rst-gpios = <&gpio0 23 GPIO_ACTIVE_LOW>; /* J4.12 */
    };
};
