MCHP_TMR32_0: Python.PythonPeripheral @ sysbus 0x40000C80
    size: 0x4
    initable: true
    filename: "scripts/pydev/counter.py"

MCHP_TMR32_1: Python.PythonPeripheral @ sysbus 0x40000CA0
    size: 0x4
    initable: true
    filename: "scripts/pydev/counter.py"

flash0: Memory.MappedMemory @ sysbus 0xc0000
    size: 0x58000

sram0: Memory.MappedMemory @ sysbus 0x118000
    size: 0x10000

// autogenerated

nvic0: IRQControllers.NVIC @ {
    sysbus new Bus.BusPointRegistration { address: 0xe000e000; cpu: cpu0 }
}
    -> cpu0@0
    systickFrequency: 32768

cpu0: CPU.CortexM @ sysbus
    cpuType: "cortex-m4"
    nvic: nvic0

uart1: UART.NS16550 @ sysbus 0x400f2800
    ->nvic0@41

// cortex-m overlay

dwt: Miscellaneous.DWT @ sysbus 0xE0001000
    frequency: 72000000

// microchip,mec172xnsz overlay

sysbus:
    init add:
        Tag <0x4008010C 4> "OSC_ID" 0xFFFFFFFF
        Tag <0x40007400 4> "MCHP_RTMR_BASE" 0xFFFFFFFF
